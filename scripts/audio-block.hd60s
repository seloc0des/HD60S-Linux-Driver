# The real audio-enable, from trial3 ~idx 46140-46214 (runs while streaming).
# CS42L51 codec (slave 0x94) config + MCU GPIO commands + 0xd4 reg4 + unmute.
i2c_write 0x94 0x09 0x46
i2c_write 0x94 0x18 0x0f
mst_write 0x02 0x27 0x00
i2c_write 0x94 0x03 0xa0
# MCU GPIO commands -- force PA pins (audio clock/reset gating). NEVER done before.
mcu_write 0x66 0xAA 0x12 0x34 0x90 0x05 0x00
mcu_write 0x66 0xAA 0x12 0x34 0x90 0x03 0x00
mcu_write 0x66 0xd4 0x00 0x04 0x03
i2c_write 0x94 0x0e 0x86
i2c_write 0x94 0x0f 0x86
i2c_write 0x94 0x10 0x05
i2c_write 0x94 0x11 0x05
i2c_write 0x94 0x04 0x0e
i2c_write 0x94 0x07 0x00
i2c_write 0x94 0x10 0x05
i2c_write 0x94 0x11 0x05
i2c_write 0x94 0x0a 0x00
i2c_write 0x94 0x0b 0x00
i2c_write 0x94 0x0c 0x00
i2c_write 0x94 0x0d 0x00
cpld_write 0x20 0x05
delay 500
