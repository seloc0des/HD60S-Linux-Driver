# p0 0xB0 bit 0 = video output enable. Every init table leaves it clear (0x24).
# For 1080p60 the vendor end state is 0x25 (colorspace mode 2 in bits 5:4).
mst_write 0x00 0xb0 0x25
mst_rmw   0x00 0xb0 0xff 0x01
# the rest of the vendor's 1080p60 output block
mst_write 0x00 0xad 0x05
mst_write 0x00 0xb1 0xc0
mst_write 0x00 0xb2 0x00
mst_write 0x00 0xb3 0x00
mst_write 0x00 0xb4 0x54
mst_write 0x00 0xb5 0x0c
mst_rmw   0x00 0xae 0xff 0x04
mst_rmw   0x00 0xab 0x7f 0x00
# front-end reset pulse the vendor always issues after HDMI init
mst_write 0x02 0x07 0xf4
mst_write 0x02 0x07 0x04
# p1 0x24 is the EDID-SRAM control reg; 0x41 = EDID disabled, 0x40 is correct
mst_write 0x01 0x24 0x40
# and re-assert the output enable after all that
mst_write 0x00 0xb0 0x25
