# MST3367_HDMI_INIT, exact, 0x18C40-0x18D8E.
#
# The critical structure my earlier scripts could not express: step 7 is a
# read-modify-write of register 0x00 -- the PAGE register itself -- setting
# bit 7, and that bit must STAY SET across the 0xCE/0xCF writes. Any helper
# that re-selects the page first destroys the hold, so those two writes use
# mst_raw*, which does not touch the page register.

mst_rmw 0x02 0x01 0x0f 0x60     # 0x18C5A-0x18C7C
mst_rmw 0x02 0x04 0xff 0x01     # 0x18C81-0x18C9C
mst_write 0x02 0x06 0x08        # 0x18CA1
mst_rmw 0x02 0x09 0xff 0x20     # 0x18CB1-0x18CCC
mst_rmw 0x00 0x54 0xef 0x00     # 0x18CD1-0x18CEC
mst_rmw 0x00 0xac 0xff 0x80     # 0x18CF1-0x18D0C  (leaves page 0 selected)

# --- bit-7 hold on the page register ------------------------------------
mst_rawrmw 0x00 0xff 0x80       # 0x18D11-0x18D2C  set bit 7
mst_rawrmw 0xce 0xff 0x80       # 0x18D31-0x18D4C
mst_rawrmw 0xcf 0xfa 0x02       # 0x18D51-0x18D6E
mst_rawrmw 0x00 0x7f 0x00       # 0x18D73-0x18D8E  clear bit 7

# --- page-0x80 TMDS trim, branch A (equivalent to V=3) ------------------
mst_rmw 0x80 0xd0 0xfd 0x01
mst_rmw 0x80 0xcf 0xff 0x80

delay 500
mst_read 0x00 0x55
mst_read 0x00 0x5b
mst_read 0x00 0x5c
mst_read 0x00 0x6a
mst_read 0x00 0x6b
mst_read 0x00 0x14
mst_read 0x02 0x0e
