# Mode detect on PAGE 0 (the vendor driver loads page with `xor edx,edx`),
# plus the HPD bit and the EDID EEPROM.
mst_read 0x00 0x55        # driver test: (v & 0x3c) == 0x3c
mst_read 0x00 0x57
mst_read 0x00 0x58
mst_read 0x00 0x59
mst_read 0x00 0x5a
mst_read 0x00 0x5b
mst_read 0x00 0x5c
mst_read 0x00 0x5f
mst_read 0x00 0x6a
mst_read 0x00 0x6b
mst_read 0x00 0x01
mst_read 0x00 0xb7        # bit 1 = hot-plug detect toward the source
mst_read 0x00 0xb8
mst_read 0x02 0x28        # H total low
mst_read 0x02 0x29        # H total high
mst_read 0x02 0x47        # deep colour
mst_read 0x02 0x4c        # pixel repeat
i2c_read 0xa2 0x00        # EDID EEPROM byte 0 -- a valid EDID starts 0x00
i2c_read 0xa2 0x01        # then 0xff
