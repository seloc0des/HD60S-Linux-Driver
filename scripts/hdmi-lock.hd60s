# Minimal receiver re-lock: HPD drop, TMDS/PLL reset pulse, the page-2
# front-end steps of MST3367_HDMI_INIT, then HPD re-assert.
# Deliberately omits the page-0x80 clock steps -- they broke the lock.

mst_rmw 0x00 0xb7 0xfd 0x00      # HPD de-assert
delay 400
mst_write 0x00 0xb8 0x10
mst_write 0x00 0xb8 0x00
mst_write 0x02 0x07 0xf4         # TMDS/PLL reset
mst_write 0x02 0x07 0x04
delay 200

mst_rmw 0x02 0x01 0x0f 0x60      # 0x18c7c
mst_rmw 0x02 0x04 0xff 0x01      # 0x18c9c
mst_write 0x02 0x06 0x08         # 0x18cac
mst_rmw 0x02 0x09 0xff 0x20      # 0x18ccc
mst_rmw 0x00 0x54 0xef 0x00      # 0x18cec
mst_rmw 0x00 0xac 0xff 0x80      # 0x18d0c

delay 300
mst_rmw 0x00 0xb7 0xff 0x02      # HPD assert
delay 2000

mst_read 0x00 0x55
mst_read 0x00 0x5b
mst_read 0x00 0x5c
mst_read 0x00 0x6a
mst_read 0x00 0x6b
mst_read 0x02 0x28
mst_read 0x02 0x29
mst_read 0x00 0x01
