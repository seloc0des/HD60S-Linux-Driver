# Full bring-up: CPLD video path (CY3014_HwReset) + MST3367 receiver front end.
#
# CPLD register map, from CY3014_HwReset (VMA 0x6b0a0) and MST3367_HwInitialize:
#   0x3B  input route      0x02 = HDMI  (0x80 = analog)
#   0x20  mode             0x05
#   0x00  GPIO data port 0
#   0x10  GPIO dir port 0  0 = output
#   0x01  GPIO data port 1 bits 0,1 = HDMI hot-plug/enable lines
#   0x11  GPIO dir port 1  0xFC = bits 0,1 outputs

cpld_read 0x3b
cpld_write 0x3b 0x02        # route HDMI
cpld_write 0x20 0x05
cpld_write 0x00 0x01        # data port 0, pin 0 high
cpld_write 0x10 0xfe        # dir port 0, pin 0 output
cpld_rmw  0x01 0xff 0x03    # data port 1, assert both HDMI lines
cpld_write 0x11 0xfc        # dir port 1, bits 0-1 outputs
delay 200

# --- receiver front end -------------------------------------------------
mst_rmw 0x00 0xb7 0xfd 0x00
delay 400
mst_write 0x00 0xb8 0x10
mst_write 0x00 0xb8 0x00
mst_write 0x02 0x07 0xf4
mst_write 0x02 0x07 0x04
delay 200
mst_rmw 0x02 0x01 0x0f 0x60
mst_rmw 0x02 0x04 0xff 0x01
mst_write 0x02 0x06 0x08
mst_rmw 0x02 0x09 0xff 0x20
mst_rmw 0x00 0x54 0xef 0x00
mst_rmw 0x00 0xac 0xff 0x80
delay 300
mst_rmw 0x00 0xb7 0xff 0x02
delay 2000

poll_mst 0x00 0x55 0x3c 0x3c 80
mst_read 0x00 0x55
mst_read 0x00 0x6a
mst_read 0x00 0x6b
mst_read 0x02 0x28
mst_read 0x02 0x29
