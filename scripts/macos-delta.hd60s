# Delta recovered from the macOS libUB530 implementation, applied after the
# Windows-derived bring-up. Items are ordered most-targeted-first.

# --- 1. IT6612 (slave 0x9a): a chip we have never written to at all ------
# macOS gates on regs 1,2,3 == 49 12 16, which our unit matches exactly.
i2c_read 0x9a 0x01
i2c_read 0x9a 0x02
i2c_read 0x9a 0x03
i2c_write 0x9a 0x05 0x00
i2c_write 0x9a 0x04 0x3d
delay 5
i2c_write 0x9a 0x04 0x1d
i2c_write 0x9a 0x61 0x30
i2c_write 0x9a 0x09 0xb2
i2c_write 0x9a 0x0a 0xf8
i2c_write 0x9a 0x0b 0x37
i2c_write 0x9a 0xc9 0x00
i2c_write 0x9a 0xca 0x00
i2c_write 0x9a 0xcb 0x00
i2c_write 0x9a 0xcc 0x00
i2c_write 0x9a 0xcd 0x00
i2c_write 0x9a 0xce 0x00
i2c_write 0x9a 0xcf 0x00
i2c_write 0x9a 0xd0 0x00
i2c_write 0x9a 0x10 0x01
i2c_write 0x9a 0x15 0x09
delay 50

# --- 2. p0 0x11 / 0x20 / 0x21, which we never write ---------------------
# macOS writes these immediately before reading p0 0x0E.
mst_write 0x00 0x11 0x2d
mst_write 0x00 0x20 0xc0
mst_write 0x00 0x21 0x04

# --- 3. the p0 0x00 |= 0x80 half we were missing after p0 0xAC |= 0x80 ---
mst_rmw 0x00 0xac 0xff 0x80
mst_rawrmw 0x00 0xff 0x80
mst_rawrmw 0x00 0x7f 0x00

# --- 4. V-counter enable: p0 0x0E |= 0x08 -------------------------------
mst_read 0x00 0x0e
mst_rmw  0x00 0x0e 0xff 0x08
delay 200
mst_read 0x00 0x5b
mst_read 0x00 0x5c

# --- 5. latch/restart trigger: toggle p0 0x0E bit 2, read in both phases -
mst_rmw 0x00 0x0e 0xfb 0x04
delay 120
mst_read 0x00 0x5b
mst_read 0x00 0x5c
mst_rmw 0x00 0x0e 0xfb 0x00
delay 120
mst_read 0x00 0x5b
mst_read 0x00 0x5c

# --- status ------------------------------------------------------------
mst_read 0x00 0x55
mst_read 0x00 0x6a
mst_read 0x00 0x6b
mst_read 0x02 0x28
mst_read 0x02 0x29
mst_read 0x02 0x0e
