# Full bring-up transcribed from the vendor driver (CY3014.X64.SYS).
# Step numbers refer to docs/BRINGUP-PLAN.md.

# --- 2-4: FX3 init commands --------------------------------------------
vendor_out 0xEC 0x0000 0x0000 0xB8 0x22 0x00 0x00 0x00 0xC0 0x00 0x00 0x00 0xCA
-vendor_out 0xC2 0x0000 0x0000   # stalls pre-SET_INTERFACE; vendor discards the result too
vendor_out 0xC7 0x0064 0x0000

# --- 10: go/no-go, proves MCU->I2C->MST3367 end to end ------------------
mst_write 0x00 0x07 0xa5
expect_mst 0x00 0x07 0xff 0xa5

# --- 11: scanner capability ---------------------------------------------
vendor_out 0xC6 0x0000 0x0100

# --- 12-16: CPLD video path ---------------------------------------------
cpld_read 0x3b
cpld_write 0x20 0x05
cpld_write 0x00 0x01
cpld_write 0x10 0xfe

# --- 18-25: MST3367 core ------------------------------------------------
mst_write 0x00 0x13 0x08
mst_rmw   0x00 0xb7 0xfd 0x00    # assert HPD (active low)
mst_write 0x00 0x41 0x6f
mst_write 0x00 0xb8 0x00
mst_write 0x01 0x0f 0x02
mst_write 0x01 0x16 0x30
mst_write 0x01 0x17 0x00
mst_write 0x01 0x18 0x00
mst_write 0x01 0x19 0x00
mst_write 0x01 0x1a 0x50
mst_rmw   0x01 0x2a 0xff 0x07
mst_write 0x02 0x08 0x03

# --- 27-34 --------------------------------------------------------------
mst_write 0x01 0x24 0x40
mst_write 0x01 0x30 0x80
mst_write 0x01 0x31 0x00
mst_write 0x01 0x32 0x00
mst_write 0x00 0xb0 0x14
mst_rmw   0x00 0xae 0xff 0x04
mst_write 0x00 0xad 0x05
mst_write 0x00 0xb1 0xc0
mst_write 0x00 0xb2 0x00
mst_write 0x00 0xb3 0x00
mst_write 0x00 0xb4 0x55
mst_rmw   0x00 0xb4 0xfc 0x00

# --- 35-46: page 2 front end -------------------------------------------
mst_write 0x02 0x01 0x61
mst_write 0x02 0x02 0xf5
mst_rmw   0x02 0x03 0xff 0x02
mst_write 0x02 0x04 0x01
mst_write 0x02 0x05 0x00
mst_write 0x02 0x06 0x08
mst_write 0x02 0x1c 0x1a
mst_write 0x02 0x1d 0x00
mst_write 0x02 0x1e 0x00
mst_write 0x02 0x1f 0x00
mst_rmw   0x02 0x25 0xff 0xa2
mst_rmw   0x02 0x02 0xff 0x80
mst_rmw   0x02 0x07 0xff 0x04
mst_write 0x02 0x17 0xc0
mst_write 0x02 0x19 0xff
mst_write 0x02 0x1a 0xff
mst_write 0x02 0x1b 0xfc
mst_write 0x02 0x20 0x00
mst_rmw   0x02 0x21 0xfc 0x00
mst_write 0x02 0x22 0x26
mst_write 0x02 0x27 0x00
mst_rmw   0x02 0x2e 0xff 0xa1
mst_rmw   0x00 0xab 0x95 0x15
mst_rmw   0x00 0xac 0xd5 0x15

# --- 47-49: pulses ------------------------------------------------------
mst_rmw   0x00 0xb7 0xfd 0x00    # assert HPD (active low)
mst_write 0x00 0xb8 0x10
mst_write 0x00 0xb8 0x00
mst_write 0x02 0x07 0xf4
mst_write 0x02 0x07 0x04
mst_write 0x00 0x51 0x89

# --- 50-52: TMDS_HOT_PLUG(3) then B7 = 0 (as Windows does) --------------
mst_rmw   0x00 0xb7 0xfd 0x00
cpld_rmw  0x20 0xff 0x10
mst_write 0x00 0xb7 0x00

# --- 53: MST3367_HDMI_INIT ---------------------------------------------
mst_rmw   0x02 0x01 0x0f 0x60
mst_rmw   0x02 0x04 0xff 0x01
mst_write 0x02 0x06 0x08
mst_rmw   0x02 0x09 0xff 0x20
mst_rmw   0x00 0x54 0xef 0x00
mst_rmw   0x00 0xac 0xff 0x80
mst_rmw   0x80 0xce 0xff 0x80
mst_rmw   0x80 0xcf 0xfa 0x02
mst_rmw   0x80 0xd0 0xfc 0x00
mst_rmw   0x80 0xcf 0x7f 0x00

# --- 54-56 --------------------------------------------------------------
delay 300
cpld_write 0x20 0x05
cpld_rmw  0x20 0xef 0x00

# --- 58-60: STREAM-START BLOCK -----------------------------------------
mst_rmw   0x00 0xab 0x7f 0x80
mst_write 0x02 0x27 0xff
mst_write 0x00 0xb3 0xff
mst_write 0x01 0x24 0x41
mst_write 0x01 0x25 0x00
mst_write 0x01 0x26 0x00
mst_write 0x01 0x27 0x00
mst_write 0x01 0x27 0x00
mst_write 0x01 0x27 0x00
mst_write 0x01 0x27 0x00
mst_write 0x01 0x27 0x00
mst_rmw   0x00 0xab 0x7f 0x00
mst_write 0x02 0x27 0x00
mst_write 0x00 0xb3 0x00

# --- 61-62: wait for the receiver ---------------------------------------
delay 500
mst_read 0x02 0x0e
mst_read 0x00 0x55
mst_read 0x00 0x6a
mst_read 0x00 0x6b
mst_read 0x02 0x28
mst_read 0x02 0x29

# --- arm the register scanner (0xC6 with a list; empty payload would DISARM) ---
vendor_out 0xC6 0x0064 0x0101 0x55 0x80 0x3C 0x00 0x6A 0x80 0x0F 0x00 0x6B 0x80 0xFE 0x00 0x01 0x81 0x07 0x00 0x0B 0x82 0xDF 0x00 0x0C 0x82 0x3F 0x00 0x0E 0x82 0x08 0x00 0x48 0x82 0x60 0x00 0x9B 0x82 0xF0 0x00 0x0E 0x40 0x80 0x9A

# --- the receiver's output stage, for a progressive HD format ---
# p1 0x24 is EDID-SRAM control; 0x40 is the running value (0x41 = EDID disabled)
mst_write 0x01 0x24 0x40
mst_rmw   0x00 0xab 0x7f 0x00
mst_write 0x00 0xad 0x05
mst_write 0x00 0xb1 0xc0
mst_write 0x00 0xb2 0x00
mst_write 0x00 0xb3 0x00
mst_write 0x00 0xb4 0x54
mst_write 0x00 0xb5 0x0c
mst_rmw   0x00 0xae 0xff 0x04
# front-end reset pulse, always issued after HDMI init
mst_write 0x02 0x07 0xf4
mst_write 0x02 0x07 0x04
# and finally the output enable -- bit 0. This is what starts the pixels.
mst_write 0x00 0xb0 0x25
