# CPLD reg 0x20 -- values the BeddoRTv4 MCU writes (0x00 idle / 0x05 / 0x45).
# On BeddoRT the MCU never touches the CPLD, so the host must do it.
cpld_write 0x20 0x45
cpld_write 0x20 0x00
cpld_write 0x20 0x55
cpld_write 0x20 0x75
cpld_write 0x20 0x15
cpld_write 0x20 0x05
# GPIO port is 0x10/0x11 = 0xfe/0xff. Release the one line held low...
cpld_write 0x10 0xff
# ...then pull each of the other low-byte lines down in turn
cpld_write 0x10 0xfd
cpld_write 0x10 0xfb
cpld_write 0x10 0xf7
cpld_write 0x10 0xef
cpld_write 0x10 0xdf
cpld_write 0x10 0xbf
cpld_write 0x10 0x7f
cpld_write 0x10 0xfe
# high byte of the GPIO port
cpld_write 0x11 0xfe
cpld_write 0x11 0xfd
cpld_write 0x11 0xfb
cpld_write 0x11 0xf7
cpld_write 0x11 0xef
cpld_write 0x11 0xdf
cpld_write 0x11 0xbf
cpld_write 0x11 0x7f
cpld_write 0x11 0xff
