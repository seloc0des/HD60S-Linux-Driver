# CPLD GPIO port is regs 0x10/0x11 (16 bits, reads 0xfffe).
# Drive each line low in turn, then restore, watching for a new line type.
cpld_write 0x10 0xfc
cpld_write 0x10 0xfe
cpld_write 0x10 0xfa
cpld_write 0x10 0xfe
cpld_write 0x10 0xf6
cpld_write 0x10 0xfe
cpld_write 0x10 0xee
cpld_write 0x10 0xfe
cpld_write 0x10 0xde
cpld_write 0x10 0xfe
cpld_write 0x10 0xbe
cpld_write 0x10 0xfe
cpld_write 0x10 0x7e
cpld_write 0x10 0xfe
cpld_write 0x11 0xfe
cpld_write 0x11 0xff
cpld_write 0x11 0xfd
cpld_write 0x11 0xff
cpld_write 0x11 0xfb
cpld_write 0x11 0xff
cpld_write 0x11 0xf7
cpld_write 0x11 0xff
cpld_write 0x11 0xef
cpld_write 0x11 0xff
cpld_write 0x11 0xdf
cpld_write 0x11 0xff
cpld_write 0x11 0xbf
cpld_write 0x11 0xff
cpld_write 0x11 0x7f
cpld_write 0x11 0xff
