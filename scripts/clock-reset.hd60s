# Undo the page-0x80 clock writes, then re-run the minimal lock.
mst_write 0x80 0xce 0x00
mst_write 0x80 0xcf 0x00
mst_write 0x80 0xd0 0x00
delay 200

mst_rmw 0x00 0xb7 0xfd 0x00
delay 400
mst_write 0x00 0xb8 0x10
mst_write 0x00 0xb8 0x00
mst_write 0x02 0x07 0xf4
mst_write 0x02 0x07 0x04
delay 200
mst_rmw 0x02 0x01 0x0f 0x60
mst_rmw 0x02 0x04 0xff 0x01
mst_write 0x02 0x06 0x08
mst_rmw 0x02 0x09 0xff 0x20
mst_rmw 0x00 0x54 0xef 0x00
mst_rmw 0x00 0xac 0xff 0x80
delay 300
mst_rmw 0x00 0xb7 0xff 0x02
delay 2500

mst_read 0x00 0x55
mst_read 0x00 0x5b
mst_read 0x00 0x5c
mst_read 0x00 0x6a
mst_read 0x00 0x6b
mst_read 0x02 0x28
mst_read 0x02 0x29
