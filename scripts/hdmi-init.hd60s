# MST3367_HDMI_INIT (VMA 0x18c40), preceded by the canonical
# "HPD drop + receiver re-lock" sequence from 0x439a1 / 0x4235b.
#
# Every step is read-modify-write; values are (AND mask, OR mask).
# reg 0x00 RMW steps in the original are page switches, which our
# mst_* helpers already perform, so they are omitted.

# --- HPD drop -----------------------------------------------------------
mst_rmw 0x00 0xb7 0xfd 0x00      # clear bit 1: HPD de-assert
delay 300
mst_write 0x00 0xb8 0x10         # pulse
mst_write 0x00 0xb8 0x00
mst_write 0x02 0x07 0xf4         # TMDS/PLL reset pulse
mst_write 0x02 0x07 0x04
delay 200

# --- MST3367_HDMI_INIT: 10 fixed steps ---------------------------------
mst_rmw 0x02 0x01 0x0f 0x60      # 0x18c7c
mst_rmw 0x02 0x04 0xff 0x01      # 0x18c9c
mst_write 0x02 0x06 0x08         # 0x18cac -- only unconditional literal
mst_rmw 0x02 0x09 0xff 0x20      # 0x18ccc
mst_rmw 0x00 0x54 0xef 0x00      # 0x18cec -- clear bit 4
mst_rmw 0x00 0xac 0xff 0x80      # 0x18d0c
# 0x18d2c sets reg0 bit7 first, which selects page 0x80 -- so these two
# land on page 0x80, not page 0x00.
mst_rmw 0x80 0xce 0xff 0x80      # 0x18d4c
mst_rmw 0x80 0xcf 0xfa 0x02      # 0x18d6e -- clear bits 0,2 set bit 1

# --- page 0x80 pair, stock path ----------------------------------------
mst_rmw 0x80 0xd0 0xfc 0x00      # stock: (old & 0xFC) | ((v>>1)&3), v=0x06 -> 0x03
mst_rmw 0x80 0xcf 0x7f 0x00      # stock: (old & 0x7F) | ((v&1)<<7), v=0x06 -> 0

# --- re-assert HPD so the source re-probes ------------------------------
delay 300
mst_rmw 0x00 0xb7 0xfd 0x00      # assert HPD (bit is ACTIVE LOW)
delay 1500

# --- did it lock? -------------------------------------------------------
poll_mst 0x00 0x55 0x3c 0x3c 60
mst_read 0x00 0x55
mst_read 0x00 0x5b
mst_read 0x00 0x5c
mst_read 0x00 0x6a
mst_read 0x00 0x6b
mst_read 0x02 0x28
mst_read 0x02 0x29
