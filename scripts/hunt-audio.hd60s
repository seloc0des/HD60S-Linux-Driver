# Re-run the CPLD/GPIO surface now that video actually flows -- the earlier
# sweep measured against a dead stream, so its "no effect" proves nothing.
cpld_rmw  0x20 0xff 0x10
cpld_rmw  0x20 0xff 0x40
cpld_rmw  0x20 0xff 0x02
cpld_rmw  0x20 0xff 0x08
cpld_write 0x20 0x45
cpld_write 0x20 0x05
cpld_write 0x11 0xfc
cpld_write 0x11 0xff
cpld_write 0x10 0xfc
cpld_write 0x10 0xfe
cpld_write 0x00 0x03
cpld_write 0x00 0x01
cpld_write 0x3b 0x02
cpld_write 0x3b 0x00
# receiver audio output side
mst_write 0x02 0x1b 0xff
mst_write 0x02 0x1b 0xfc
mst_write 0x02 0x27 0xff
mst_write 0x02 0x27 0x00
mst_write 0x02 0x17 0x00
mst_write 0x02 0x17 0xc0
mst_write 0x02 0x22 0x27
mst_write 0x02 0x22 0x26
